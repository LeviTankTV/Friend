{
  "name": "friend-desktop",
  "productName": "Mira",
  "version": "0.1.0",
  "private": true,
  "author": "LeviTankTV",
  "description": "Mira — живой компаньон на рабочий стол: прозрачное окно поверх всех, память и характер",
  "homepage": "https://github.com/LeviTankTV/Friend",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:dev": "electron . --dev",
    "go": "node ../scripts/build-go.js",
    "dist": "npm run go && electron-builder"
  },
  "dependencies": {
    "gifenc": "^1.0.3"
  },
  "devDependencies": {
    "electron": "^32.2.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "dev.friend.companion",
    "productName": "Mira",
    "directories": {
      "output": "../dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../bin",
        "to": "bin"
      },
      {
        "from": "../web",
        "to": "web"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.lifestyle",
      "identity": null,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Микрофон нужен для голосового ввода и отклика по имени; запись распознаётся локально и не покидает компьютер"
      }
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "synopsis": "Живой компаньон на рабочий стол: характер, память, забота — локально",
      "maintainer": "LeviTankTV <LeviTankTV@users.noreply.github.com>",
      "desktop": {
        "Name": "Mira",
        "Comment": "Живой компаньон на рабочий стол"
      }
    }
  }
}
