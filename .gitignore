bin/
node_modules/
*.log
.zcode/

# Собранные бинари (companion/focuswatch/soundwatch и отладочные копии):
# сборка идёт в bin/, случайные артефакты в server/ — мусор, не код.
server/*.exe
server/companion
server/focuswatch
server/soundwatch
server/soundwatch_dbg

# Windows-артефакт случайного редиректа в start.bat: имя зарезервировано,
# git на нём падает.
nul

# Файл ключей: в нём лежит ключ API, ему в репозитории не место.
.env
*.local.env

# Сборочные каталоги установщиков
/dist/
/dist2/
/dist.old-lock/

# Состояние дев-прогонов: память/проактив, написанные живыми проверками.
fast-memory.json
fast-proactive.json
